# Run `npm run env:sync` after pulling — merges new keys from this file into .env (never overwrites values).
# This file is in git; real `.env` is not. For CI/CD you can optionally set GitHub secret SERVER_DOTENV_B64
# to `base64 < .env | tr -d '\n'` so each deploy uploads `.env` to the server (see .github/workflows/ci-cd.yml).
# Docker Compose overrides DATABASE_URL and REDIS_URL inside the `app` container; keep these for local `npm run start:dev`.
DATABASE_URL="postgresql://gift:gift@localhost:5432/gift_sniper?schema=public"
REDIS_URL="redis://localhost:6379"
# Host port published for the API when using Docker Compose (app still listens on 3000 inside the container).
# Default in compose is 3010 if unset — change if 3010 is taken on your host.
APP_PORT=3010
TELEGRAM_BOT_TOKEN=""
# Set to 1 to log every incoming Telegram update type (noisy; for debugging /start).
LOG_TELEGRAM_UPDATES=""
# Set to 1 so long-polling startup calls deleteWebhook(drop_pending_updates=true) once.
TELEGRAM_DROP_PENDING_UPDATES=""
# Optional: MRKT HTTP JSON feed (GET, array or { "listings": [] }). Overrides native MRKT API when set.
MRKT_LISTINGS_URL=""
# Native MRKT (https://api.tgmrkt.io): set MRKT_TOKEN **or** MRKT_INIT_DATA. Leave both empty + MRKT_LISTINGS_URL empty → mock data.
MRKT_API_BASE="https://api.tgmrkt.io/api/v1"
MRKT_TOKEN=""
# Raw tgWebAppData init string; used only if MRKT_TOKEN is empty. Expires — refresh periodically.
MRKT_INIT_DATA=""
# Optional: merge JSON into POST /gifts/saling body (e.g. {"ordering":null,"count":20}).
MRKT_SALING_JSON=""
MRKT_SALING_MAX_PAGES=3
MRKT_USER_AGENT=""
MRKT_POLL_MS=2000
# Redis stream key for normalized events
EVENT_STREAM_KEY="gifts:events:v1"
# Alert dedupe TTL seconds
ALERT_DEDUPE_TTL_SEC=300
# Free tier: delay alerts by ms (0 = instant for dev)
FREE_TIER_ALERT_DELAY_MS=60000
# Optional: `GET /admin/stats` + `POST /admin/replay` — send header `X-Admin-Token: <same value>`.
ADMIN_TOKEN=""
# Set to `1` to send alerts only from MRKT collector (skip duplicate work in ingestion).
ALERTS_FROM_FAST_PATH_ONLY=""
# Set to `0` to disable fast-path alerts from collector (ingestion-only alerts).
FAST_ALERT_FROM_COLLECTOR=""
# Future market stubs (logs a warning when set to `1` until APIs are wired).
TONNEL_ENABLED=""
PORTALS_ENABLED=""
