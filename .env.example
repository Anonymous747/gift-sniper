# Run `npm run env:sync` after pulling — merges new keys from this file into .env (never overwrites values).
# This file is in git; real `.env` is not. For CI/CD you can optionally set GitHub secret SERVER_DOTENV_B64
# to `base64 < .env | tr -d '\n'` so each deploy uploads `.env` to the server (see .github/workflows/ci-cd.yml).
# Docker Compose overrides DATABASE_URL and REDIS_URL inside the `app` container; keep these for local `npm run start:dev`.
DATABASE_URL="postgresql://gift:gift@localhost:5432/gift_sniper?schema=public"
REDIS_URL="redis://localhost:6379"
# Host port published for the API when using Docker Compose (app still listens on 3000 inside the container).
# Default in compose is 3010 if unset — change if 3010 is taken on your host.
APP_PORT=3010
TELEGRAM_BOT_TOKEN=""
# Set to 1 to log every incoming Telegram update type (noisy; for debugging /start).
LOG_TELEGRAM_UPDATES=""
# Set to 1 so long-polling startup calls deleteWebhook(drop_pending_updates=true) once.
TELEGRAM_DROP_PENDING_UPDATES=""
# Optional: MRKT HTTP JSON feed (GET, array or { "listings": [] }). Used only if MRKT_TOKEN and MRKT_INIT_DATA are both unset,
# unless MRKT_PREFER_HTTP_FEED=1 (then URL wins over native API — slim feeds → missing model/backdrop in alerts).
MRKT_LISTINGS_URL=""
# Set to `1` to force MRKT_LISTINGS_URL even when MRKT_TOKEN or MRKT_INIT_DATA is set (legacy; not recommended).
MRKT_PREFER_HTTP_FEED=""
# Native MRKT (https://api.tgmrkt.io): set MRKT_TOKEN **or** MRKT_INIT_DATA → POST /gifts/saling with full gifts[] like the MRKT app.
# Leave native auth AND MRKT_LISTINGS_URL empty → MRKT collector idle (no synthetic listings).
MRKT_API_BASE="https://api.tgmrkt.io/api/v1"
# Sticker CDN for Mini App gift/model pickers (paths from MRKT catalog).
MRKT_CDN_BASE="https://cdn.tgmrkt.io"
# Cache TTL (ms) for MRKT GET /gifts/collections + POST /gifts/models (Mini App catalog).
MRKT_CATALOG_CACHE_MS=900000
# Set to 0 to disable resolving gift series labels against GET /gifts/collections (canonical titles like the MRKT app).
MRKT_CATALOG_ENRICH=""
# Leave unset entirely if unused — MRKT_TOKEN="" (empty) disables native API same as missing token.
MRKT_TOKEN=""
# Raw tgWebAppData init string; used only if MRKT_TOKEN is empty. Expires — refresh periodically.
MRKT_INIT_DATA=""
# Optional: merge JSON into POST /gifts/saling body (e.g. {"ordering":null,"count":20}).
MRKT_SALING_JSON=""
MRKT_SALING_MAX_PAGES=3
MRKT_USER_AGENT=""
MRKT_POLL_MS=2000
# Redis stream key for normalized events
EVENT_STREAM_KEY="gifts:events:v1"
# Alert dedupe TTL seconds
ALERT_DEDUPE_TTL_SEC=300
# Free tier: delay alerts by ms (0 = instant for dev)
FREE_TIER_ALERT_DELAY_MS=60000
# TON→USD for alerts: fetched from Binance TONUSDT, then CoinGecko; cache TTL (seconds). Default 300. Range 60–3600.
TON_USD_CACHE_SEC=300
# Optional: `GET /admin/stats` + `POST /admin/replay` — send header `X-Admin-Token: <same value>`.
ADMIN_TOKEN=""
# `1` = skip ingestion Telegram when collector fast-path is on (dedupe). Ignored if FAST_ALERT_FROM_COLLECTOR=0.
ALERTS_FROM_FAST_PATH_ONLY=""
# `0` = no collector fast-path; ingestion sends Telegram. Leave empty = fast-path on (default).
FAST_ALERT_FROM_COLLECTOR=""
# Future market stubs (logs a warning when set to `1` until APIs are wired).
TONNEL_ENABLED=""
PORTALS_ENABLED=""

# --- Intelligence platform layer ---
# JSON array bootstrapped into `IntelFeedChannel` on startup, e.g.
# [{"slug":"beautiful_serials","title":"Beautiful Serials","recipe":"beautiful_serial","telegramChatId":"-1001234567890"}]
INTEL_CHANNELS_JSON=""
# Set to `1` so the bot posts matching listings (and arbitrage) into those channels (bot must be admin).
INTEL_FEED_POSTING_ENABLED=""
# Cross-market spread threshold (%) before arbitrage channel posts (needs 2+ markets + same collection+serial).
ARBIT_MIN_SPREAD_PCT="12"
# Mini App auth: max age of `auth_date` in initData (seconds).
TWA_MAX_AUTH_AGE_SEC="86400"
# Mini App: public HTTPS origin of this API (no trailing slash). Same host you register in BotFather for the Web App.
# Production: https://game.foryou.quest — TLS + reverse proxy to the app port; Web App URL https://game.foryou.quest/mini
# Leave empty for local dev (browser uses same origin for /mini/listings).
PUBLIC_APP_BASE_URL=""
